{
  "name": "rehearsal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rehearsal — a real-time voice AI English tutor. Monorepo root.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "codegen": "pnpm --filter @rehearsal/contracts codegen",
    "build": "pnpm --filter @rehearsal/contracts build",
    "check": "pnpm check:loader && pnpm check:schema && pnpm check:courses",
    "check:courses": "pnpm --filter @rehearsal/contracts check:courses",
    "check:schema": "pnpm --filter @rehearsal/contracts check:schema",
    "check:loader": "pnpm --filter @rehearsal/contracts check:loader"
  }
}
