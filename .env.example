# Rehearsal local development environment.
# Copy this file to .env and replace placeholders with local/provider values.
# Never commit .env or real credentials.

# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Browser/API
WEB_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
PUBLIC_API_BASE_URL=http://127.0.0.1:3000

# Control-plane authentication
# Generate locally with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=rehearsal-control-plane
JWT_AUDIENCE=rehearsal-web
JWT_TTL_SECONDS=86400
DEV_AUTH_ENABLED=true

# Storage
REDIS_URL=redis://127.0.0.1:6379
SQLITE_PATH=./data/rehearsal.sqlite
COURSES_DIR=./courses
SESSION_LIVE_TTL_SECONDS=86400
SESSION_SWEEP_SECONDS=5
SESSION_START_GRACE_MS=30000
SESSION_CLOSE_TIMEOUT_MS=5000

# LiveKit server credentials (server/worker only; never expose in web code)
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret
LIVEKIT_AGENT_NAME=rehearsal-agent
LIVEKIT_TOKEN_TTL_SECONDS=3600

# ─── The cascade (ARCHITECTURE §8.6) ────────────────────────────────────────
# All LiveKit inference plugins, authenticated by the credentials above —
# no additional provider key is required.
STT_MODEL=assemblyai/universal-3-5-pro
LLM_MODEL=google/gemma-4-31b-it
TTS_MODEL=fishaudio/s2.1-pro
TTS_VOICE=

# The text-only paths run on smaller models (ARCHITECTURE §10.5): a card is one
# sentence and does not need the capacity a persona needs.
COACH_LLM_MODEL=google/gemma-4-31b-it
DEBRIEF_LLM_MODEL=google/gemma-4-31b-it

# ─── Turn taking (ARCHITECTURE §8.5) ────────────────────────────────────────
# The learner's patience window, in milliseconds, per level. This is a floor,
# not a delay — semantic endpointing still runs on top of it.
TURN_PATIENCE_MS_A2=1800
TURN_PATIENCE_MS_B1=1500
TURN_PATIENCE_MS_B2=1100
