# Rehearsal local development environment.
# Copy this file to .env and replace placeholders with local/provider values.
# Never commit .env or real credentials.

# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Browser/API
WEB_ORIGIN=http://127.0.0.1:5173
PUBLIC_API_BASE_URL=http://127.0.0.1:3000

# Control-plane authentication
# Generate locally with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=rehearsal-control-plane
JWT_AUDIENCE=rehearsal-web
JWT_TTL_SECONDS=86400
DEV_AUTH_ENABLED=true

# Storage
REDIS_URL=redis://127.0.0.1:6379
DATA_DIR=apps/control-plane/.data
COURSES_DIR=courses
SESSION_LIVE_TTL_SECONDS=86400
SESSION_SWEEP_SECONDS=5
SESSION_START_GRACE_MS=30000
SESSION_CLOSE_TIMEOUT_MS=5000

# LiveKit server credentials (server/worker only; never expose in web code)
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret
LIVEKIT_AGENT_NAME=rehearsal-agent
LIVEKIT_TOKEN_TTL_SECONDS=3600

# Agent-worker models
STT_MODEL=replace-with-stt-model
LLM_MODEL=replace-with-character-llm-model
COACH_LLM_MODEL=replace-with-coach-llm-model
TTS_MODEL=replace-with-tts-model
# Optional; leave empty to use the provider default.
TTS_VOICE=

# Learner-aware turn detection
TURN_PATIENCE_MS_A2=2000
TURN_PATIENCE_MS_B1=1600
TURN_PATIENCE_MS_B2=1200
SESSION_TTL_SECONDS=86400

# Product/cost knobs (not currently required by all modules)
DEBRIEF_LLM_MODEL=
SQLITE_PATH=apps/control-plane/.data/rehearsal.sqlite
PAUSE_BUDGET=
MAX_SESSION_MINUTES=
