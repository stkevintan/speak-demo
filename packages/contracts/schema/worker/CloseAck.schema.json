{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "commandId": {
      "type": "string",
      "minLength": 1
    },
    "workerId": {
      "type": "string",
      "minLength": 1
    },
    "epoch": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "finalSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "record": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "courseId": {
          "type": "string",
          "minLength": 1
        },
        "transcript": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "learner",
                  "character"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "tStart": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "tEnd": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "role",
              "text",
              "tStart",
              "tEnd"
            ],
            "additionalProperties": false
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "nice",
                  "nit"
                ]
              },
              "category": {
                "type": "string",
                "minLength": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "better": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              },
              "zh": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "category",
              "quote",
              "en",
              "zh"
            ],
            "additionalProperties": false
          }
        },
        "signal": {
          "type": "object",
          "properties": {
            "nice": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "nice",
            "total"
          ],
          "additionalProperties": false
        },
        "goalMet": {
          "type": "boolean"
        },
        "learnerTurns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endReason": {
          "type": "string",
          "enum": [
            "user",
            "quit",
            "network",
            "goal",
            "budget"
          ]
        }
      },
      "required": [
        "sessionId",
        "courseId",
        "transcript",
        "findings",
        "signal",
        "goalMet",
        "learnerTurns",
        "endReason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "sessionId",
    "commandId",
    "workerId",
    "epoch",
    "finalSeq",
    "record"
  ],
  "additionalProperties": false
}
