{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "idle",
        "listening",
        "thinking",
        "speaking",
        "ended"
      ]
    },
    "learnerTurn": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "turnId": {
              "type": "string",
              "minLength": 1
            },
            "canCommit": {
              "type": "boolean"
            }
          },
          "required": [
            "turnId",
            "canCommit"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "transcript": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "learner",
              "character"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "tStart": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "tEnd": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "turnId": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "enum": [
              "asr",
              "typed",
              "character"
            ]
          }
        },
        "required": [
          "role",
          "text",
          "tStart",
          "tEnd",
          "turnId",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "nice",
              "nit"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "better": {
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string",
            "minLength": 1
          },
          "zh": {
            "type": "string",
            "minLength": 1
          },
          "findingId": {
            "type": "string",
            "minLength": 1
          },
          "turnId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "category",
          "quote",
          "en",
          "zh",
          "findingId",
          "turnId"
        ],
        "additionalProperties": false
      }
    },
    "suggestions": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 1
            },
            "options": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "prompt",
            "options"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "preferences": {
      "type": "object",
      "properties": {
        "suggestions": {
          "type": "boolean"
        }
      },
      "required": [
        "suggestions"
      ],
      "additionalProperties": false
    },
    "endReason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "user",
            "quit",
            "network",
            "goal",
            "budget"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "state",
    "learnerTurn",
    "transcript",
    "cards",
    "suggestions",
    "preferences",
    "endReason"
  ],
  "additionalProperties": false
}
