{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "commandId": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "enum": [
        "user",
        "quit",
        "network",
        "goal",
        "budget"
      ]
    }
  },
  "required": [
    "v",
    "sessionId",
    "commandId",
    "reason"
  ],
  "additionalProperties": false
}
