{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "workerId": {
      "type": "string",
      "minLength": 1
    },
    "epoch": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "idle",
            "listening",
            "thinking",
            "speaking",
            "ended"
          ]
        },
        "learnerTurn": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "turnId": {
                  "type": "string",
                  "minLength": 1
                },
                "canCommit": {
                  "type": "boolean"
                }
              },
              "required": [
                "turnId",
                "canCommit"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "transcript": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "learner",
                  "character"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "tStart": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "tEnd": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "turnId": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "enum": [
                  "asr",
                  "typed",
                  "character"
                ]
              }
            },
            "required": [
              "role",
              "text",
              "tStart",
              "tEnd",
              "turnId",
              "source"
            ],
            "additionalProperties": false
          }
        },
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "nice",
                  "nit"
                ]
              },
              "category": {
                "type": "string",
                "minLength": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "better": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              },
              "zh": {
                "type": "string",
                "minLength": 1
              },
              "findingId": {
                "type": "string",
                "minLength": 1
              },
              "turnId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "category",
              "quote",
              "en",
              "zh",
              "findingId",
              "turnId"
            ],
            "additionalProperties": false
          }
        },
        "suggestions": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "prompt": {
                  "type": "string",
                  "minLength": 1
                },
                "options": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "prompt",
                "options"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "preferences": {
          "type": "object",
          "properties": {
            "suggestions": {
              "type": "boolean"
            }
          },
          "required": [
            "suggestions"
          ],
          "additionalProperties": false
        },
        "endReason": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "user",
                "quit",
                "network",
                "goal",
                "budget"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "learnerTurn",
        "transcript",
        "cards",
        "suggestions",
        "preferences",
        "endReason"
      ],
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "nice",
              "nit"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "better": {
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string",
            "minLength": 1
          },
          "zh": {
            "type": "string",
            "minLength": 1
          },
          "findingId": {
            "type": "string",
            "minLength": 1
          },
          "turnId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "category",
          "quote",
          "en",
          "zh",
          "findingId",
          "turnId"
        ],
        "additionalProperties": false
      }
    },
    "signal": {
      "type": "object",
      "properties": {
        "nice": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "nice",
        "total"
      ],
      "additionalProperties": false
    },
    "goalMet": {
      "type": "boolean"
    },
    "learnerTurns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "v",
    "sessionId",
    "workerId",
    "epoch",
    "seq",
    "snapshot",
    "findings",
    "signal",
    "goalMet",
    "learnerTurns"
  ],
  "additionalProperties": false
}
