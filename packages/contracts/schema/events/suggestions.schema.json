{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "suggestions"
    },
    "payload": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "prompt",
        "options"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "payload"
  ],
  "additionalProperties": false
}
