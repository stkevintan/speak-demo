{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "type": {
      "type": "string",
      "const": "coach.card"
    },
    "payload": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "nice",
            "nit"
          ]
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "better": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        },
        "zh": {
          "type": "string",
          "minLength": 1
        },
        "findingId": {
          "type": "string",
          "minLength": 1
        },
        "turnId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "category",
        "quote",
        "en",
        "zh",
        "findingId",
        "turnId"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "sessionId",
    "id",
    "seq",
    "type",
    "payload"
  ],
  "additionalProperties": false
}
