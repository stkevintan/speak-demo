{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "number",
      "const": 0
    },
    "type": {
      "type": "string",
      "const": "learner.text"
    },
    "payload": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "sessionId",
    "id",
    "seq",
    "type",
    "payload"
  ],
  "additionalProperties": false
}
