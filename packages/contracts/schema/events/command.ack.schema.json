{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "type": {
      "type": "string",
      "const": "command.ack"
    },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "commandId": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "const": "accepted"
            }
          },
          "required": [
            "commandId",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "commandId": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "const": "rejected"
            },
            "code": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "commandId",
            "status",
            "code"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "v",
    "sessionId",
    "id",
    "seq",
    "type",
    "payload"
  ],
  "additionalProperties": false
}
