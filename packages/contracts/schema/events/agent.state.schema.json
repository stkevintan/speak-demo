{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "agent.state"
    },
    "payload": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "idle",
            "listening",
            "thinking",
            "speaking",
            "ended"
          ]
        }
      },
      "required": [
        "state"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "payload"
  ],
  "additionalProperties": false
}
