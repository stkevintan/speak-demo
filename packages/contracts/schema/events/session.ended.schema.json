{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "type": {
      "type": "string",
      "const": "session.ended"
    },
    "payload": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "user",
            "quit",
            "network",
            "goal",
            "budget"
          ]
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "sessionId",
    "id",
    "seq",
    "type",
    "payload"
  ],
  "additionalProperties": false
}
