                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "suggestionsOffered": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "suggestionsAdopted": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "nice": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "nit": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "points": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
