                "sessionId",
                "attempt",
                "startedAt",
                "endedAt",
                "mark",
                "won",
                "durationMs",
                "learnerTurns",
                "suggestionsOffered",
                "suggestionsAdopted",
                "nice",
                "nit",
                "points"
              ],
              "additionalProperties": false
            }
