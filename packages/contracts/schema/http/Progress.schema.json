                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "learnerTurns": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "suggestionsOffered": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "suggestionsAdopted": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "nice": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "nit": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "points": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "sessionId",
                  "attempt",
                  "startedAt",
                  "endedAt",
                  "mark",
                  "won",
                  "durationMs",
                  "learnerTurns",
                  "suggestionsOffered",
                  "suggestionsAdopted",
                  "nice",
                  "nit",
                  "points"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
