{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "totals": {
      "type": "object",
      "properties": {
        "met": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unfinished": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "notStarted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "met",
        "unfinished",
        "notStarted"
