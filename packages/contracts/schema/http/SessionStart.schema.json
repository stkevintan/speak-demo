{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "livekit": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "token": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "url",
        "token"
      ],
      "additionalProperties": false
    },
    "recalled": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "lastSeen": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "category",
          "count",
          "lastSeen"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "sessionId",
    "livekit",
    "recalled"
  ],
  "additionalProperties": false
}
